 "regression_test": "\"\"\"Regression test exported by Careo.\n\nIt replays a minimized scenario against the configured reference and candidate\nfrom a clean, verified state. It FAILS while the behavioral difference exists\nand passes once the candidate matches the reference again.\n\"\"\"\n\nfrom pathlib import Path\n\nfrom careo.scenarios.runner import replay_file\n\n\ndef test_careo_regression() -> None:\n    result = replay_file(Path(__file__).with_name(\"regression.json\"))\n    assert result.verdict == \"MATCH\", result.describe()\n",
 "spec": "# Careo stateful demo: reference booking API vs. an AI-rewrite-style candidate\n# with a deliberately seeded retry-cancellation regression. See README.md.\nversion: 1\n\nservices:\n  reference:\n    name: reference\n    command: [\"python3\", \"app_reference.py\", \"--port\", \"{port}\", \"--db\", \"{db}\"]\n    base_url: http://127.0.0.1:{port}\n    ready_path: /health\n  candidate:\n    name: ai-rewrite\n    command: [\"python3\", \"app_candidate.py\", \"--port\", \"{port}\", \"--db\", \"{db}\"]\n    base_url: http://127.0.0.1:{port}\n    ready_path: /health\n\nstate:\n  kind: sqlite\n  schema: schema.sql\n  fixture: seed.sql\n  reset: sqlite          # Careo wipes and reloads the DB, then verifies it\n  compare: each_step     # compare persistent state after every operation\n  tables:\n    - name: bookings\n      id_columns: {id: booking}\n    - name: events\n      ignore_columns: [id]            # internal autoincrement counter\n      id_columns: {booking_id: booking}\n\nentities: [booking]\n\noperations:\n  - name: create_booking\n    method: POST\n    path: /bookings\n    body:\n      customer: {sampled_from: [\"ana\", \"bo\", \"chen\"]}\n      slot: {sampled_from: [\"08:00\", \"09:00\", \"10:00\", \"11:00\"]}\n    produces: {entity: booking, pointer: /id}\n    expect_status: [201, 409]\n  - name: get_booking\n    method: GET\n    path: /bookings/{id}\n    params: {id: {bundle: booking}}\n    ids: [{entity: booking, pointer: /id}]\n  # Raw ids: only the fixture booking (1) and an id no implementation will\n  # generate. Raw ids of *generated* entities differ legitimately between\n  # implementations; use {bundle: booking} to reach those.\n  - name: get_raw_booking\n    method: GET\n    path: /bookings/{id}\n    params: {id: {sampled_from: [1, 999999]}}\n  - name: cancel_booking\n    method: POST\n    path: /bookings/{id}/cancel\n    params: {id: {bundle: booking}}\n    ids: [{entity: booking, pointer: /id}]\n  - name: reschedule_booking\n    method: PATCH\n    path: /bookings/{id}\n    params: {id: {bundle: booking}}\n    body:\n      slot: {sampled_from: [\"08:00\", \"09:00\", \"10:00\", \"11:00\"]}\n    ids: [{entity: booking, pointer: /id}]\n  - name: list_bookings\n    method: GET\n    path: /bookings\n    query:\n      limit: {integers: {min: 1, max: 3}}\n      offset: {integers: {min: 0, max: 3}}\n    ids: [{entity: booking, pointer: /items/*/id}]\n\nhttp:\n  timeout_seconds: 5\n  compare_headers: [content-type]\n\ngeneration:\n  seed: 20261102\n  max_scenarios: 200\n  max_steps: 25\n  shrink: true\n  replay_checks: 3\n",
 "sources": {
  "reference": {
   "file": "examples/booking-api/app_reference.py",
   "function": "def cancel(self, bid):\n    b = self.booking(bid)\n    if b is None:\n        return 404, {\"error\": \"not_found\"}\n    if b[\"status\"] == \"cancelled\":\n        return 409, {\"error\": \"already_cancelled\"}\n    self.db.execute(\"UPDATE bookings SET status = 'cancelled' WHERE id = ?\", (bid,))\n    self.event(bid, \"cancelled\")\n    return 200, self.booking(bid)"
  },
  "candidate": {
   "file": "examples/booking-api/app_candidate.py",
   "function": "def handle_cancel(store, booking_id):\n    booking = store.get(booking_id)\n    if not booking:\n        return 404, {\"error\": \"not_found\"}\n    # \"Make cancellation idempotent\" -- SEEDED BUG: the retry still emits an event\n    # and returns success instead of 409 already_cancelled.\n    store.conn.execute(\"UPDATE bookings SET status = 'cancelled' WHERE id = ?\", (booking_id,))\n    store.record(booking_id, \"cancelled\")\n    return 200, store.get(booking_id)"
  }
 },
 "seeded_bug": "Deliberately seeded: retrying a cancellation returns 200 and records a second 'cancelled' event instead of 409 already_cancelled."
}
